services:
  - type: web
    name: cinemora-ai-api
    runtime: docker
    rootDir: backend
    plan: free
    healthCheckPath: /health
    envVars:
      - key: OPENAI_API_KEY
        sync: false
      - key: FAL_KEY
        sync: false
      - key: FAL_TEXT_TO_VIDEO_MODEL
        sync: false
      - key: CORS_ORIGINS
        sync: false
